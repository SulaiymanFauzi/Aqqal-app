# Copy this file to .env and fill in values
# Google AI Studio / Gemini API Key
GOOGLE_API_KEY=

# Default model (you can override per-request via body.model)
# Examples: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=8000

# CORS: comma-separated list; leave empty to allow all in dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:19006,http://127.0.0.1:19006

SYSTEM_PROMPT_PATH=./top-secret-prompt.txt

# --- External API configuration for api_tools.py ---
# Base URLs (override only if needed)
AQQAL_API_BASE=https://api.aqqal.com
QURAN_API_BASE=https://api.quran.com/api/v4
JSDELIVR_BASE=https://cdn.jsdelivr.net

# Aqqal semantic search credentials
# Set the API key provided by Aqqal here (do NOT commit real keys)
AQQAL_SEMANTIC_APIKEY=
# Service account identifier (default: 'aqqal')
AQQAL_SEMANTIC_SERVICE_ACCOUNT=aqqal

# HTTP client options
# API_HTTP_TIMEOUT in seconds (float). Default: 15
API_HTTP_TIMEOUT=15
AQQAL_API_KEY=
AQQAL_API_KEY_HEADER=Authorization
AQQAL_API_KEY_PREFIX=Bearer